# Example environment variables for development
# Copy this file to .env and replace placeholder values before starting

# Secret used by session/cookies — keep this secret in production
SECRET_KEY=your-secret-key-here

# Postgres DB used by the backend (compose sets a default for development)
# Provide a `POSTGRES_PASSWORD` and optionally `DATABASE_URL`.
# Example `POSTGRES_PASSWORD=supersecret` and
# DATABASE_URL=postgresql://admin:supersecret@postgres:5432/turnoverdb
POSTGRES_PASSWORD=your-db-password-here
DATABASE_URL=postgresql://admin:${POSTGRES_PASSWORD}@postgres:5432/turnoverdb

# Google OAuth credentials (if you plan to use Gmail sync)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Frontend will use this to call the backend API (defaults to http://localhost:8001)
VITE_API_URL=http://localhost:8001

# Optional: toggle environment (development|production)
ENV=development
